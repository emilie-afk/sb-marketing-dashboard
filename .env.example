# Names only. Set real values privately (Netlify environment variables, Functions scope). Never commit values.
DATABASE_URL=
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=
# Team access: "email:role,email:role" with role viewer | editor | admin
TEAM_MEMBERS=
# Business scope rules (kept out of the code): brands hidden everywhere, and "key:Label" channels itemized in breakdowns
EXCLUDED_BRANDS=
TRACKED_CHANNELS=
# Optional emergency sign-out of all sessions issued before this ISO time
SESSION_NOT_BEFORE=
# Spreadsheet sync, option 1 (preferred): Apps Script reader deployed from a team account (scripts/apps-script)
SHEET_READER_URL=
SHEET_READER_KEY=
# Spreadsheet sync, option 2: read-only Drive refresh token for a team account that can already view the sheets
GOOGLE_SYNC_REFRESH_TOKEN=
# Reporting pulls (read-only APIs of the team's other apps; each app issues its own revocable credential)
PLANT_BREAKDOWN_API_URL=
PLANT_BREAKDOWN_REPORTING_KEY=
GROSS_PROFIT_API_URL=
GROSS_PROFIT_REPORTING_SECRET=
CORPORATE_GIFTING_API_URL=
CORPORATE_GIFTING_REPORTING_SECRET=
# Task Tracker (one-way pull of its tasks; read-only here). Secret from the tracker's Integrations screen.
TASK_TRACKER_API_URL=
TASK_TRACKER_REPORTING_SECRET=
# Optional: the tracker's TRACKER_INSTANCE_ID (must match when set) and accepted businesses (default sb)
TASK_TRACKER_INSTANCE_ID=
TASK_TRACKER_BUSINESSES=
# Off until the ownership change for corporate figures is confirmed and existing weekly-report corporate rows are reconciled
CORPORATE_GIFTING_PULL_ENABLED=
# Local only
TEST_DATABASE_URL=
LOCAL_BLOB_DIR=
PRIVATE_TERMS_FILE=
